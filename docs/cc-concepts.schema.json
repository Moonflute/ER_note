{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ER CC concepts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "sources", "complaints"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "$ref": "#/$defs/text" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "complaints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/complaint" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "sourceIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "publisher", "locator", "accessedAt", "access"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "$ref": "#/$defs/text" },
        "locator": { "$ref": "#/$defs/text" },
        "accessedAt": { "type": "string", "format": "date" },
        "access": { "enum": ["full-text", "publisher-excerpt"] }
      }
    },
    "differential": {
      "type": "object", "additionalProperties": false,
      "required": ["disease", "clues", "sourceIds"],
      "properties": {
        "disease": { "type": "string", "minLength": 1, "maxLength": 30 },
        "clues": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "meaning": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "meaning", "itemIds", "sourceIds"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 50 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 80 },
        "itemIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "caution": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "sourceIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "complaint": {
      "type": "object", "additionalProperties": false,
      "required": ["complaintId", "scope", "differentials", "hx", "pex", "caution"],
      "properties": {
        "complaintId": { "$ref": "#/$defs/text" },
        "scope": { "enum": ["general", "pediatric", "psychiatric"] },
        "differentials": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/differential" } },
        "hx": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/meaning" } },
        "pex": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/meaning" } },
        "caution": { "$ref": "#/$defs/caution" }
      }
    }
  }
}
